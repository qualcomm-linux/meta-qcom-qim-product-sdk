diff --git a/meson.build b/meson.build
index 9ae3b41..93628a7 100644
--- a/meson.build
+++ b/meson.build
@@ -566,13 +566,18 @@ pkgconfig.generate(
 
 gpl_allowed = get_option('gpl').allowed()
 
+build_all_plugins = get_option('build-all-plugins')
+
 subdir('gst-libs')
-subdir('gst')
-subdir('sys')
 subdir('ext')
-subdir('tests')
-subdir('data')
-subdir('tools')
+
+if build_all_plugins
+  subdir('sys')
+  subdir('ext')
+  subdir('tests')
+  subdir('data')
+  subdir('tools')
+endif
 
 if have_orcc
   update_orc_dist_files = find_program('scripts/update-orc-dist-files.py')
@@ -598,11 +603,13 @@ if have_orcc
 endif
 
 # xgettext is optional (on Windows for instance)
-if find_program('xgettext', required : get_option('nls')).found()
-  subdir('po')
-endif
+if build_all_plugins
+  if find_program('xgettext', required : get_option('nls')).found()
+    subdir('po')
+  endif
 
-subdir('scripts')
+  subdir('scripts')
+endif
 
 # Set release date
 if gst_version_nano == 0
@@ -621,7 +628,9 @@ configure_file(output : 'config.h', configuration : cdata)
 
 meson.add_dist_script('scripts/gen-changelog.py', meson.project_name(), '1.22.0', meson.project_version())
 
-subdir('docs')
+if build_all_plugins
+  subdir('docs')
+endif
 
 plugin_names = []
 gst_plugins = []
diff --git a/meson_options.txt b/meson_options.txt
index 5f91f42..b3e6813 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -263,3 +263,7 @@ option('package-origin', type : 'string', value : 'Unknown package origin', yiel
        description : 'package origin URL to use in plugins')
 option('doc', type : 'feature', value : 'auto', yield: true,
        description: 'Enable documentation.')
+
+# Build options
+option('build-all-plugins', type : 'boolean', yield : true,
+       description : 'Enable build of all plugins')
