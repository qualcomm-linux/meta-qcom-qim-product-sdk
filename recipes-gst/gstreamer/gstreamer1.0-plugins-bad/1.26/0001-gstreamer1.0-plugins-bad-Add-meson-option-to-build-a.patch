diff --git a/meson.build b/meson.build
index 5c983c5..5327f77 100644
--- a/meson.build
+++ b/meson.build
@@ -583,13 +583,18 @@ else
   pathsep = ':'
 endif
 
+build_all_plugins = get_option('build-all-plugins')
+
 subdir('gst-libs')
-subdir('gst')
-subdir('sys')
-subdir('ext')
-subdir('tests')
-subdir('data')
-subdir('tools')
+
+if build_all_plugins
+  subdir('gst')
+  subdir('sys')
+  subdir('ext')
+  subdir('tests')
+  subdir('data')
+  subdir('tools')
+endif
 
 if have_orcc
   update_orc_dist_files = find_program('scripts/update-orc-dist-files.py')
@@ -615,13 +620,14 @@ if have_orcc
 endif
 
 # xgettext is optional (on Windows for instance)
-if find_program('xgettext', required : get_option('nls')).found()
-  cdata.set('ENABLE_NLS', 1)
-  subdir('po')
+if build_all_plugins
+  if find_program('xgettext', required : get_option('nls')).found()
+    cdata.set('ENABLE_NLS', 1)
+    subdir('po')
+  endif
+  subdir('scripts')
 endif
 
-subdir('scripts')
-
 # Set release date
 if gst_version_nano == 0
   extract_release_date = find_program('scripts/extract-release-date-from-doap-file.py')
@@ -639,7 +645,9 @@ configure_file(output : 'config.h', configuration : cdata)
 
