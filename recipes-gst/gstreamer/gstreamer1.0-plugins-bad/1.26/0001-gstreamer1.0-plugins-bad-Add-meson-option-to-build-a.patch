diff --git a/meson_options.txt b/meson_options.txt
index 35e252d..090ea5d 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -299,6 +299,10 @@ option('glib_checks', type : 'boolean', value : true, yield : true, description
   deprecated: {'enabled' : 'true', 'disabled' : 'false', 'auto' : 'false'},
 )
 
+# Build options
+option('build-all-plugins', type : 'boolean', yield : true,
+       description : 'Enable build of all plugins')
+
 # Deprecated, kept for backward compat
 option('gobject-cast-checks', type : 'feature', value : 'auto', yield : true,
        description: 'Enable run-time GObject cast checks (auto = enabled for development, disabled for stable releases)',
