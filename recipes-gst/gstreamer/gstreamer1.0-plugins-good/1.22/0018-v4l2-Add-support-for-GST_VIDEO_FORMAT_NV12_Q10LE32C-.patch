From af97d945b72c70e4b6db3d941fbd28f3c9e0e5b0 Mon Sep 17 00:00:00 2001
From: Pratik Pachange <ppachang@qti.qualcomm.com>
Date: Tue, 16 Sep 2025 14:34:02 +0530
Subject: [PATCH] v4l2: Add support for GST_VIDEO_FORMAT_NV12_Q10LE32C format

Upstream-Status: Inappropriate [Qualcomm Specific]

Signed-off-by: Pratik Pachange <ppachang@qti.qualcomm.com>
---
 sys/v4l2/ext/videodev2.h |  1 +
 sys/v4l2/gstv4l2.c       |  4 ++++
 sys/v4l2/gstv4l2object.c | 12 ++++++++++++
 3 files changed, 17 insertions(+)

diff --git a/sys/v4l2/ext/videodev2.h b/sys/v4l2/ext/videodev2.h
index fd9df85..c738173 100644
--- a/sys/v4l2/ext/videodev2.h
+++ b/sys/v4l2/ext/videodev2.h
@@ -742,6 +742,7 @@ struct v4l2_pix_format {
 #define V4L2_PIX_FMT_CNF4     v4l2_fourcc('C', 'N', 'F', '4') /* Intel 4-bit packed depth confidence information */
 #define V4L2_PIX_FMT_HI240    v4l2_fourcc('H', 'I', '2', '4') /* BTTV 8-bit dithered RGB */
 #define V4L2_PIX_FMT_QC08C    v4l2_fourcc('Q', '0', '8', 'C') /* Qualcomm 8-bit compressed */
+#define V4L2_PIX_FMT_QC10C    v4l2_fourcc('Q', '1', '0', 'C') /* Qualcomm 10-bit compressed */
 
 /* 10bit raw bayer packed, 32 bytes for every 25 pixels, last LSB 6 bits unused */
 #define V4L2_PIX_FMT_IPU3_SBGGR10	v4l2_fourcc('i', 'p', '3', 'b') /* IPU3 packed 10-bit BGGR bayer */
diff --git a/sys/v4l2/gstv4l2.c b/sys/v4l2/gstv4l2.c
index 2d60709..b416a2e 100644
--- a/sys/v4l2/gstv4l2.c
+++ b/sys/v4l2/gstv4l2.c
@@ -105,6 +105,10 @@ gst_v4l2_probe_template_caps (const gchar * device, gint video_fd,
         case V4L2_PIX_FMT_BGR32:
           alt_t = gst_structure_copy (template);
           gst_structure_set (alt_t, "format", G_TYPE_STRING, "BGRA", NULL);
+          break;
+        case V4L2_PIX_FMT_QC08C:
+          alt_t = gst_structure_copy (template);
+          gst_structure_set (alt_t, "format", G_TYPE_STRING, "NV12_Q10LE32C", NULL);
         default:
           break;
       }
diff --git a/sys/v4l2/gstv4l2object.c b/sys/v4l2/gstv4l2object.c
index a6a395b..048cdb6 100644
--- a/sys/v4l2/gstv4l2object.c
+++ b/sys/v4l2/gstv4l2object.c
@@ -166,6 +166,7 @@ static const GstV4L2FormatDesc gst_v4l2_formats[] = {
   {V4L2_PIX_FMT_NV42, TRUE, GST_V4L2_RAW},
   {V4L2_PIX_FMT_MM21, TRUE, GST_V4L2_RAW},
   {V4L2_PIX_FMT_QC08C, TRUE, GST_V4L2_RAW},
+  {V4L2_PIX_FMT_QC10C, TRUE, GST_V4L2_RAW},
 
   /* Bayer formats - see http://www.siliconimaging.com/RGB%20Bayer.htm */
   {V4L2_PIX_FMT_SBGGR8, TRUE, GST_V4L2_RAW},
@@ -1439,6 +1440,9 @@ gst_v4l2_object_v4l2fourcc_to_video_format (guint32 fourcc)
     case V4L2_PIX_FMT_QC08C:
       format = GST_VIDEO_FORMAT_NV12_Q08C;
       break;
+    case V4L2_PIX_FMT_QC10C:
+      format = GST_VIDEO_FORMAT_NV12_Q10LE32C;
+      break;
     default:
       format = GST_VIDEO_FORMAT_UNKNOWN;
       break;
@@ -1579,6 +1583,7 @@ gst_v4l2_object_v4l2fourcc_to_bare_struct (guint32 fourcc)
     case V4L2_PIX_FMT_NV61M:
     case V4L2_PIX_FMT_NV24:    /* 24  Y/CrCb 4:4:4  */
     case V4L2_PIX_FMT_QC08C:
+    case V4L2_PIX_FMT_QC10C:
     case V4L2_PIX_FMT_YVU410:
     case V4L2_PIX_FMT_YUV410:
     case V4L2_PIX_FMT_YUV420:  /* I420/IYUV */
@@ -1897,6 +1902,9 @@ gst_v4l2_object_get_caps_info (GstV4l2Object * v4l2object, GstCaps * caps,
       case GST_VIDEO_FORMAT_NV12_Q08C:
         fourcc = V4L2_PIX_FMT_QC08C;
         break;
+      case GST_VIDEO_FORMAT_NV12_Q10LE32C:
+        fourcc = V4L2_PIX_FMT_QC10C;
+        break;
       case GST_VIDEO_FORMAT_YVYU:
         fourcc = V4L2_PIX_FMT_YVYU;
         break;
@@ -3479,6 +3487,10 @@ gst_v4l2_object_save_format (GstV4l2Object * v4l2object,
     padded_width = stride;
   }
 
+  /* For Q10C format, padded width should be represented in pixels */
+  if (GST_VIDEO_INFO_FORMAT (info) == GST_VIDEO_FORMAT_NV12_Q10LE32C)
+    padded_width = (padded_width * 3) / 4;
+
   if (padded_width < format->fmt.pix.width)
     GST_WARNING_OBJECT (v4l2object->dbg_obj,
         "Driver bug detected, stride (%d) is too small for the width (%d)",
